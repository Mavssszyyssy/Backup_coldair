# Add these values in Vercel Project Settings -> Environment Variables.
# Never commit or upload a real .env.vercel file.

NODE_ENV=production
SEED_ADMIN_PASSWORD=SET_A_PRIVATE_ADMIN_SEED_PASSWORD
SEED_TECHNICIAN_PASSWORD=SET_A_PRIVATE_TECHNICIAN_SEED_PASSWORD
SEED_SUPERADMIN_PASSWORD=SET_A_PRIVATE_SUPERADMIN_SEED_PASSWORD

# Copy this exact value from backend/.env (do not expose it publicly).
MONGODB_URI=PASTE_VALUE_FROM_BACKEND_DOT_ENV
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=

# Generate a long random value, or copy your existing production JWT secret.
JWT_SECRET=PASTE_OR_GENERATE_A_LONG_RANDOM_SECRET

# Replace the frontend placeholder after your web application is deployed.
# Keep localhost entries only if you want local browser testing to remain allowed.
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://YOUR-FRONTEND.vercel.app
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

# Intended Vercel backend domain.
BACKEND_PUBLIC_URL=https://aeropulse-backend.vercel.app
MOBILE_URL_SCHEME=coldair

# Copy only the payment and messaging values that you actively use.
PAYMONGO_MODE=PASTE_VALUE_FROM_BACKEND_DOT_ENV
PAYMONGO_SECRET_KEY=PASTE_VALUE_FROM_BACKEND_DOT_ENV
PAYMONGO_PUBLIC_KEY=PASTE_VALUE_FROM_BACKEND_DOT_ENV
PAYMONGO_WEBHOOK_SECRET=PASTE_VALUE_FROM_BACKEND_DOT_ENV
PAYMONGO_API_BASE_URL=https://api.paymongo.com

# Resend transactional email (email OTP, password recovery, and notifications).
# Keep the API key server-side. Use a sender on a domain verified in Resend.
RESEND_API_KEY=PASTE_YOUR_SERVER_SIDE_RESEND_API_KEY
RESEND_FROM_EMAIL=AeroPulse <no-reply@YOUR_VERIFIED_DOMAIN.com>

# Infobip SMS OTP only. Create an API key with the sms:message:send scope.
# Copy the Base URL from Infobip Developer Tools, without https:// or /sms/...
INFOBIP_API_KEY=PASTE_NEW_INFOBIP_SMS_API_KEY
INFOBIP_BASE_URL=YOUR_ACCOUNT.api.infobip.com
# Use ServiceSMS while on the Infobip trial. Use your approved sender later.
INFOBIP_SENDER=ServiceSMS
